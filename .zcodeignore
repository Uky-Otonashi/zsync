# runtime data (archives / staging / node.json) — never commit user data
data/
*.ztar
*.manifest.json

# python
__pycache__/
*.pyc
.venv/

# desktop client build artifacts (client/BUILD.md)
build/
dist/
bin/
client/zsync-client.spec
server/zsync-server.spec
# zsync logo (assets/icon.ico + zsync-icon-*.png, web/icon.png favicon) 是自绘图标,
# 随仓库分发; 严禁用 zcode 官方图标替换(版权, 见 client/BUILD.md)

# internal dev scaffolding (not part of the open-source tree)
.scratch/
docs/
tools/
ref/
AGENTS.md
CONTEXT.md

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
